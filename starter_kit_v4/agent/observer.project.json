{
  "schema_version": "observer-project-v1",
  "protocol": "jsonl-v4",
  "image": "python:3.12-slim",
  "build": [],
  "run": [
    "python3",
    "-u",
    "baseline_agent.py"
  ],
  "working_directory": ".",
